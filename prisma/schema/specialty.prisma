model Specialty{
  id String @id @unique @default(uuid()) 
  title String @unique 
  description String? 
  icon String? 
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt 

  isDeleted Boolean @default(false) 
  deletedAt DateTime? 

  @@index([isDeleted],name:"idx_sp_deleted") 
  @@index([title],name:"idx_sp_title") 
  @@map("specialties")
}